  "item": [
    {
      "id": "d71bfeee-852b-4b88-81d9-0bc5820c170f",
      "name": "PSP Checking Service",
      "description": {
        "content": "Third-Party Provider identity and regulatory validation",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "39ce3fd9-b3de-4c4f-ab59-fef58c3b1c54",
          "name": "Check PSP eIDAS Certificate and Regulatory Status",
          "request": {
            "name": "Check PSP eIDAS Certificate and Regulatory Status",
            "description": {
              "content": "Validates a Base64-encoded eIDAS certificate presented by a Third-Party\nProvider (TPP) in real time. Returns certificate validity (QTSP,\nsignature, revocation, expiry), the home register (issuing NCA), and\nthe host register (operating NCA) plus the payment services the TPP is\nauthorised to provide in the requested jurisdiction.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "psp",
                "eidas"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "jurisdiction",
                  "value": "<string>",
                  "description": "(Required) ISO 3166 two-letter country code where the FI holds the customer's account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Local NCA reference for the ASPSP making the request. Recommended format is the eIDAS authorization number.",
                "key": "fi_reference_id",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Optional custom reference for audit/tracking purposes.",
                "key": "transaction_reference",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) API endpoint version identifier.",
                "key": "version",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Base64-encoded eIDAS certificate presented by the TPP.",
                "key": "eidas",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "be735e84-035e-49f7-bead-cbfa97a5f7a5",
