              "body": "{\n  \"eIDAS\": {\n    \"data\": {\n      \"pspSubjectName\": \"string\",\n      \"authNumber\": \"string\",\n      \"QTSPCommonName\": \"string\",\n      \"QTSPSource\": \"string\",\n      \"QTSPJurisdiction\": \"string\"\n    },\n    \"validity\": {\n      \"validQTSP\": true,\n      \"validSignature\": true,\n      \"notRevoked\": false,\n      \"notExpired\": true\n    }\n  },\n  \"homeRegister\": {\n    \"ncaName\": \"string\",\n    \"ncaCountryCode\": \"string\",\n    \"registerType\": \"string\",\n    \"categoryEntries\": [\n      {\n        \"categoryName\": \"string\",\n        \"pspLegalName\": \"string\",\n        \"pspAuthStatus\": \"string\",\n        \"pspPaymentServices\": [\n          5347,\n          9309\n        ]\n      },\n      {\n        \"categoryName\": \"string\",\n        \"pspLegalName\": \"string\",\n        \"pspAuthStatus\": \"string\",\n        \"pspPaymentServices\": [\n          5490,\n          9061\n        ]\n      }\n    ]\n  },\n  \"hostRegister\": {\n    \"ncaName\": \"string\",\n    \"ncaCountryCode\": \"string\",\n    \"registerType\": \"string\",\n    \"categoryEntries\": [\n      {\n        \"categoryName\": \"string\",\n        \"pspLegalName\": \"string\",\n        \"pspAuthStatus\": \"string\",\n        \"pspPaymentServices\": [\n          4798,\n          7260\n        ]\n      },\n      {\n        \"categoryName\": \"string\",\n        \"pspLegalName\": \"string\",\n        \"pspAuthStatus\": \"string\",\n        \"pspPaymentServices\": [\n          7928,\n          5336\n        ]\n      }\n    ],\n    \"warning\": [\n      \"string\",\n      \"string\"\n    ]\n  }\n}",
